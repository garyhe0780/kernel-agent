generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  projectMembers ProjectMember[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model Workspace {
  id           String       @id @default(cuid())
  name         String
  createdAt    DateTime     @default(now())
  accessGroups AccessGroup[]
  memberships  Membership[]
  projects     Project[]
  drafts       ProjectDraft[]
  plans        BuilderPlan[]
  capabilities Capability[]
  records      BusinessRecord[]
  changes      ChangeSet[]
  agentRuns    AgentRun[]
  embeddedOperations EmbeddedOperation[]
  executions   Execution[]
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  shell       String
  description String    @default("")
  version     Int       @default(1)
  definition  Json?
  assembly    Json?
  packages    Json
  versions    ProjectVersion[]
  accessGroups AccessGroup[]
  accessPolicies AccessPolicy[]
  members     ProjectMember[]
  invitations ProjectInvitation[]
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model ProjectDraft {
  id            String    @id @default(cuid())
  workspaceId   String
  brief         String
  definition    Json
  assembly      Json?
  version       Int       @default(1)
  status        String    @default("draft")
  source        String
  projectSlug   String?
  baseProjectVersion Int?
  preview       Json?
  publishedVersion Int?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status])
}

model ProjectVersion {
  id          String   @id @default(cuid())
  projectId   String
  version     Int
  definition  Json
  migration   Json
  publishedBy String
  createdAt   DateTime @default(now())
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, version])
}

model Membership {
  groups      AccessGroupMember[]
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("owner")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Capability {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String
  version     Int       @default(1)
  definition  Json
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    CapabilityVersion[]
  @@unique([workspaceId, slug])
}

model CapabilityVersion {
  id           String     @id @default(cuid())
  capabilityId String
  version      Int
  definition   Json
  publishedBy  String
  createdAt    DateTime   @default(now())
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([capabilityId, version])
}

model BusinessRecord {
  id          String    @id @default(cuid())
  workspaceId String
  capability  String
  entity      String
  data        Json
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, capability, entity])
}

model ChangeSet {
  executionMode     String    @default("review")
  kind              String    @default("action")
  id                String    @id @default(cuid())
  workspaceId       String
  capability        String
  definitionVersion Int
  recordId          String
  recordVersion     Int
  action            String
  input             Json
  before            Json
  after             Json
  checks            Json
  status            String    @default("pending")
  proposedBy        String
  actorKind         String
  idempotencyKey    String
  agentCredentialId String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([agentCredentialId, createdAt])
}

model Execution {
  id          String    @id @default(cuid())
  workspaceId String
  recordId    String?
  changeId    String?
  action      String
  outcome     String
  actorId     String
  actorName   String
  actorKind   String
  details     Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model AgentCredential {
  id          String   @id @default(cuid())
  workspaceId String
  projectSlug String?
  kind        String   @default("operate")
  name        String
  tokenHash   String   @unique
  prefix      String
  createdBy   String
  actions     Json
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([workspaceId, projectSlug])
}

model BuilderPlan {
  id String @id @default(cuid())
  workspaceId String
  draftId String? @unique
  draftVersion Int?
  content Json
  version Int @default(1)
  status String @default("planning")
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id        String   @id @default(cuid())
  projectId String
  email     String
  tokenHash String   @unique
  createdBy String
  expiresAt DateTime
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
  @@index([email])
}

model WorkspaceInvitation {
  createdBy   String @default("")
  id          String @id @default(cuid())
  workspaceId String
  email       String
  role        String
  tokenHash   String @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  @@index([workspaceId])
}

model BuildJob {
  id          String @id @default(cuid())
  workspaceId String
  planId      String
  planVersion Int
  createdBy   String
  status      String @default("queued")
  input       Json
  checkpoints Json
  events      Json
  task        String @default("structure")
  error       Json?
  leaseToken  String?
  leaseUntil  DateTime?
  draftId     String?
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([planId, planVersion])
  @@index([workspaceId, planId])
  @@index([status, leaseUntil])
}

model AgentRun {
  id                String @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentCredentialId String
  idempotencyKey    String
  steps             Json
  receipts          Json @default("[]")
  nextStep          Int @default(0)
  revision          Int @default(0)
  status            String @default("queued")
  error             Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([agentCredentialId, idempotencyKey])
  @@index([status, updatedAt])
  @@index([workspaceId, agentCredentialId])
}

model EmbeddedOperation {
  id             String @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  idempotencyKey String
  request        Json
  plan           Json?
  leaseToken     String?
  leaseUntil     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([workspaceId, userId, idempotencyKey])
}

model AgentModelCall {
  id String @id @default(cuid())
  credentialId String
  requestId String
  createdAt DateTime @default(now())
  @@index([credentialId, createdAt])
  @@index([requestId])
}

model AgentWorkerHealth {
  id String @id
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
}

model AccessGroup {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  description String @default("")
  version     Int @default(1)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     AccessGroupMember[]
  policies    AccessPolicy[]
  @@index([workspaceId, projectId])
}

model AccessGroupMember {
  groupId      String
  membershipId String
  group        AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@id([groupId, membershipId])
  @@index([membershipId])
}

model AccessPolicy {
  id        String @id @default(cuid())
  groupId   String
  projectId String?
  role      String
  group     AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([groupId])
}
