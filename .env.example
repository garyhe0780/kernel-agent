DATABASE_URL="file:./kernel.db"
BETTER_AUTH_URL="http://localhost:3000"
# pnpm setup generates a random local secret; set your own for deployment.
BETTER_AUTH_SECRET=""

# Optional live builder and project agent: OpenAI Responses-compatible API.
# Credentials are used on the server only. The purchasing example works without them.
# Full base URL including the provider path prefix, without /responses.
KERNEL_API_BASE_URL="https://api.openai.com/v1"
KERNEL_API_KEY=""
KERNEL_MODEL=""
# Backward-compatible key fallback when KERNEL_API_KEY is empty.
OPENAI_API_KEY=""
# Bedrock Responses example: use a Bedrock API key and a supported model/profile.
# KERNEL_API_BASE_URL="https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1"

# Optional, provider-dependent. MiniMax M3 defaults to no reasoning unless set.
# KERNEL_REASONING_EFFORT="medium"

# Full request deadline, including response body (default 5 minutes; max 15 minutes).
KERNEL_MODEL_TIMEOUT_MS="300000"
