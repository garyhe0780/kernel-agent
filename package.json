{
  "name": "kernel-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node --import tsx scripts/migrate-local.ts",
    "setup": "node --import tsx scripts/setup.ts && prisma generate && node --import tsx scripts/migrate-local.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "accept:agent": "node --import tsx scripts/accept-agent.ts",
    "accept:model": "node --import tsx scripts/accept-model.ts",
    "test:browser-recovery": "vite --config tests/browser-recovery/vite.config.ts --host 127.0.0.1 --port 3010 --strictPort",
    "worker": "node --import tsx scripts/build-worker.ts",
    "deploy": "CLOUDFLARE=1 vite build && wrangler deploy",
    "preview:cf": "CLOUDFLARE=1 vite preview",
    "cf-typegen": "wrangler types",
    "accept:production": "node --import tsx scripts/accept-production.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pglite-prisma-adapter": "0.7.2",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.147.0"
  }
}
